FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

COPY package.json package-lock.json ./
COPY backend/scripts/invoice_parser/requirements.txt \
    backend/scripts/invoice_parser/requirements.txt

RUN npm ci

RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir \
       -r backend/scripts/invoice_parser/requirements.txt

# PaddleOCR modellerini image build sırasında indirip doğrula. Böylece runtime
# internet/model-host erişimine ihtiyaç duymaz ve uyumsuzluk build aşamasında yakalanır.
COPY backend/scripts/invoice_parser/ocr_runtime.py backend/scripts/invoice_parser/ocr_runtime.py
COPY backend/scripts/invoice_parser/preload_ocr_models.py backend/scripts/invoice_parser/preload_ocr_models.py
RUN PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True \
    python backend/scripts/invoice_parser/preload_ocr_models.py

COPY tsconfig.json ./
COPY backend ./backend

RUN mkdir -p /app/uploads

ENV NODE_ENV=development
ENV PORT=3000

EXPOSE 3000

CMD ["npm", "run", "dev:api"]